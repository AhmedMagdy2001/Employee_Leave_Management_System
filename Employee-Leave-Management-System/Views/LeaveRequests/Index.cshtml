@model IEnumerable<EmployeeLeaveManagement.Models.LeaveRequest>

@{
    ViewData["Title"] = "Leave Requests";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h2>Leave Requests</h2>

    <a asp-action="Create"
       class="btn btn-primary">

        Apply for Leave

    </a>

</div>

<table class="table table-striped table-hover align-middle">

    <thead>

        <tr>

            <th>Employee</th>

            <th>Leave Type</th>

            <th>Start Date</th>

            <th>End Date</th>

            <th>Status</th>

            <th></th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Employee?.EmployeeName</td>

                <td>@item.LeaveType?.LeaveTypeName</td>

                <td>@item.StartDate</td>

                <td>@item.EndDate</td>

                <td>

                    @using EmployeeLeaveManagement.Helpers

                    <span class="badge @item.Status.BadgeClass()">
                        @item.Status
                    </span>

                </td>

                <td>

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-info btn-sm text-white">
                        Details
                    </a>

                    @if (item.Status == EmployeeLeaveManagement.Models.LeaveStatus.Pending)
                    {
                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-action="Approve"
                           asp-route-id="@item.Id"
                           class="btn btn-success btn-sm"
                           onclick="return confirm('Approve this leave request?');">
                            Approve
                        </a>

                        <a asp-action="Reject"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('Reject this leave request?');">
                            Reject
                        </a>
                    }

                </td>

            </tr>
        }

    </tbody>

</table>