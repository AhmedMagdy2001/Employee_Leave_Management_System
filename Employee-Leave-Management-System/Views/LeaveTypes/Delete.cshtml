@model EmployeeLeaveManagement.Models.LeaveType

@{
    ViewData["Title"] = "Delete";
}

<h2 class="text-danger mb-4">Delete Leave Type</h2>

<p>
    Are you sure you want to delete this leave type?
</p>
<div>
    <h4>LeaveType</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.LeaveTypeName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.LeaveTypeName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MaximumDaysAllowed)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MaximumDaysAllowed)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>
