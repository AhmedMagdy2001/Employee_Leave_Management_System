@model IEnumerable<EmployeeLeaveManagement.Models.LeaveType>

@{
    ViewData["Title"] = "Index";
}

<h2 class="mb-4">Leave Types</h2>

<p>
    <a asp-action="Create" class="btn btn-primary mb-3">
        Add Leave Type
    </a>
</p>
<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.LeaveTypeName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaximumDaysAllowed)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.LeaveTypeName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaximumDaysAllowed)
            </td>
            <td>
                <a asp-action="Edit"
                    asp-route-id="@item.Id"
                    class="btn btn-warning btn-sm">
                    Edit
                </a>

                <a asp-action="Details"
                    asp-route-id="@item.Id"
                    class="btn btn-info btn-sm text-white">
                    Details
                </a>

                <a asp-action="Delete"
                    asp-route-id="@item.Id"
                    class="btn btn-danger btn-sm">
                    Delete
                </a>
            </td>
        </tr>
}
    </tbody>
</table>
