@model EmployeeLeaveManagement.Models.LeaveType

@{
    ViewData["Title"] = "Details";
}

<h2 class="mb-4">Leave Type Details</h2>

<div>
    <h4>LeaveType</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.LeaveTypeName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.LeaveTypeName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MaximumDaysAllowed)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MaximumDaysAllowed)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit"
       asp-route-id="@Model?.Id"
       class="btn btn-warning">
        Edit
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>
</div>
